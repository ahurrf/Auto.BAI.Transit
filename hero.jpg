<script>
(function () {
  function initializeTOC() {
    // Reuse if it already exists, otherwise create
    let contents = document.getElementById('js-toc');
    if (!contents) {
      contents = document.createElement('nav');
      contents.id = 'js-toc';
      contents.setAttribute('aria-label', 'Table of contents');
    } else {
      contents.innerHTML = ''; // reset if re-running
    }

    const keyTakeaways = document.querySelector('.key-takeaways');
    const firstH2 = document.querySelector('h2');
    if (keyTakeaways) keyTakeaways.insertAdjacentElement('afterend', contents);
    else if (firstH2) firstH2.insertAdjacentElement('beforebegin', contents);
    else document.body.prepend(contents);

    // Collect only meaningful H2/H3s not inside the TOC
    const all = Array.from(document.querySelectorAll('h2, h3'));
    const headers = all.filter(h => {
      if (h.closest('#js-toc')) return false;
      const text = h.textContent.replace(/s+/g, ' ').trim();
      const hasImg = !!h.querySelector('img');
      return text.length > 0 && !hasImg;
    });

    const footer = document.querySelector('footer');
    const tocLinks = [];
    const usedIds = new Set();
    let seq = 1;

    // Unicode-safe slugify
    function slugify(str) {
      const base = (str || '')
        .toString()
        .normalize('NFD')
        .replace(/p{M}+/gu, '')
        .toLowerCase()
        .trim()
        .replace(/[^p{L}p{N}]+/gu, '-')
        .replace(/^-+|-+$/g, '');
      return base || 'section';
    }

    function ensureId(el) {
      const existing = (el.id || '').trim();
      let base = existing ? existing : slugify(el.textContent);
      let id = base;
      while (!id || usedIds.has(id) || document.getElementById(id)) {
        id = base + '-' + (seq++);
      }
      el.id = id;
      usedIds.add(id);
    }

    headers.forEach(h => {
      if ((h.id || '').toLowerCase() === 'continue-reading') return;
      ensureId(h);
      const link = document.createElement('a');
      link.href = '#' + h.id;
      link.textContent = h.textContent.replace(/s+/g, ' ').trim();
      link.className = 'js-toc-link';
      if (h.tagName.toLowerCase() === 'h3') link.classList.add('is-h3');
      contents.appendChild(link);
      tocLinks.push(link);
    });

    function onScroll() {
      let currentIndex = 0;
      headers.forEach((h, i) => {
        const top = h.getBoundingClientRect().top;
        if (top < window.innerHeight / 2) currentIndex = i;
      });
      tocLinks.forEach(a => a.classList.remove('active'));
      if (tocLinks[currentIndex]) tocLinks[currentIndex].classList.add('active');

      if (footer && getComputedStyle(contents).position === 'fixed') {
        const footerTop = footer.getBoundingClientRect().top;
        const hgt = contents.offsetHeight;
        const winH = window.innerHeight;
        if (footerTop < winH) {
          contents.style.top = (footerTop - hgt - 20) + 'px';
        } else {
          contents.style.top = '';
        }
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeTOC);
  } else {
    initializeTOC();
  }
})();
</script>
<style type="text/css">/* Container */
#js-toc {
  position: fixed;
  left: 20px;
  top: 100px;
  width: 300px;
  padding: 12px 16px;        /* tighter padding */
  border-radius: 8px;
  z-index: 1000;

  /* smaller, consistent type + more items visible */
  font-size: 14px;           /* was inherited; now smaller */
  line-height: 1.35;

  /* keep within viewport with scroll if long */
  max-height: calc(100vh - 140px);
  overflow-y: auto;
}

/* Title */
#js-toc::before {
  content: "Оглавление";
  display: block;
  font-size: 1.05em;         /* smaller title */
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 6px;        /* tighter spacing */
}

/* List layout resilient to theme overrides */
#js-toc .js-toc-list { list-style: none; margin: 0; padding: 0; }
#js-toc .js-toc-item { margin: 0; padding: 0; }
#js-toc .js-toc-item.is-h3 { margin-left: 0.6em; }  /* slightly reduced indent */

/* Force block links + wrapping even if theme overrides anchors */
#js-toc a.js-toc-link {
  display: block !important;
  padding: 4px 0;            /* tighter row height */
  line-height: 1.3;
  text-decoration: none;
  white-space: normal !important;
  font-size: 0.95em;         /* slightly smaller than container (≈13.3px) */
}
#js-toc a.js-toc-link::before { content: none !important; }

/* State */
#js-toc a.js-toc-link:hover { color: #d84949; text-decoration: none; }
#js-toc a.js-toc-link.active { font-weight: 500; }

/* Responsive */
@media (max-width: 1200px) {
  #js-toc {
    position: static;
    width: auto;
    padding: 12px 0;
    max-height: none;        /* no fixed height when flowing in content */
    overflow: visible;
    font-size: 15px;         /* small bump for readability on narrower screens */
  }
  #js-toc a.js-toc-link { font-size: 1em; } /* match container */
}
</style>
